{
    // 可以在这里控制各种生成字幕的参数, 下面这个链接里的参数都可以控制
    // You can control various subtitle generation parameters here, all parameters in the link below can be controlled
    // https://github.com/SYSTRAN/faster-whisper/blob/dea24cbcc6cbef23ff599a63be0bbb647a0b23d6/faster_whisper/transcribe.py#L733

    // Whisper任务：translate = 翻译输出，transcribe = 原文转写
    // Whisper task: translate = translated output, transcribe = same-language transcript
    "task": "translate",

    // VAD 参数设置 (使用改进的 whisper_vad 模型)
    // VAD parameters (using improved whisper_vad model)
    "vad_parameters": {
        // VAD检测阈值 (0.3-0.7, 推荐0.5)
        // 太大会导致漏翻, 太小可能会导致时间轴不准或文本质量下降(幻听)
        // VAD detection threshold (0.3-0.7, recommended 0.5)
        // Too high will cause missed translations, too low may cause timeline inaccuracy or text quality degradation (hallucinations)
        "threshold": 0.5,

        // 最小语音持续时间 (毫秒)
        // Minimum speech duration (milliseconds)
        "min_speech_duration_ms": 300,

        // 最小静音持续时间 (毫秒)
        // Minimum silence duration (milliseconds)
        "min_silence_duration_ms": 100,

        // 语音前后填充时间 (毫秒)
        // Speech padding before and after (milliseconds)
        "speech_pad_ms": 200,
    },

    // 避免时间轴向前偏移过长的问题
    // Avoid excessive forward shift of timeline
    "max_initial_timestamp": 30,

    "repetition_penalty": 1.1,

    // 禁止连续 20 个 token 的片段在一段输出里重复出现，防止解码陷入重复循环（循环会触发耗时的重新解码和高温采样）
    // 短句仍可正常重复（如“欢迎回来 欢迎回来”），但约 10 个 token 的短句最多只能重复到第三遍；设为 0 关闭
    // Forbid any 20-token sequence from repeating within one output, so decoding cannot get stuck in a repetition loop
    // (a loop triggers slow re-decoding and high-temperature sampling). Short phrases can still repeat; set 0 to disable
    "no_repeat_ngram_size": 20,

    // 解码失败时的温度回退序列。高温采样是幻听（凭空编造台词）的主要来源，所以上限只到 0.4
    // Temperature fallback when decoding fails. High-temperature sampling is the main source of hallucinations, so cap it at 0.4
    "temperature": [0.0, 0.2, 0.4],

    // 智能VAD切分：先用外层VAD选择安全的连续音频块，再在每个块内启用 faster-whisper 内部VAD
    // Smart VAD split: outer VAD chooses safe contiguous chunks, then faster-whisper internal VAD runs inside each chunk
    "smart_split_with_vad": true,

    // 每个智能切分块的目标时长（秒），最大30秒
    // Target duration for each smart split chunk (seconds), capped at 30 seconds
    "target_chunk_duration_s": 30,

    // 字幕后处理：合并重复/重叠片段，避免字幕时间轴过长
    // Subtitle post-processing: merge repeated/overlapping segments and avoid overly long timelines
    "segment_merge": {
        // 是否启用合并
        // Enable merging
        "enabled": true,

        // 只有当相邻两段之间的间隔 <= max_gap_ms 时才允许合并（避免跨长静音误合并）
        // Only merge if the gap between adjacent segments is <= max_gap_ms (avoid merging across long silences)
        "max_gap_ms": 2000,

        // 单条字幕合并后的最大时长（毫秒），超过则停止合并（避免出现几十秒/几分钟的超长字幕）
        // Maximum duration (ms) of a merged subtitle; stop merging when exceeded
        "max_duration_ms": 20000,
    },

    // 字幕后处理：一条字幕跨过长停顿时，在停顿处拆开（文字按空格/标点切分），避免静音期间字幕一直挂着
    // Subtitle post-processing: split a subtitle that runs across a long pause (text is cut at spaces/punctuation)
    "pause_split": {
        // 是否启用
        // Enable
        "enabled": true,

        // 停顿至少多长（毫秒）才拆分
        // Minimum pause (ms) to split at
        "min_pause_ms": 1500,
    },

    // 字幕后处理：丢弃明显的幻听
    // Subtitle post-processing: drop obvious hallucinations
    "hallucination_filter": {
        // 是否启用
        // Enable
        "enabled": true,

        // 每秒字数超过此值的字幕视为幻听（不计空格和标点）
        // Subtitles with more characters per second than this are hallucinations (spaces and punctuation not counted)
        "max_chars_per_second": 20,

        // 字数少于此值的字幕不做每秒字数检查
        // Subtitles shorter than this are not checked for characters per second
        "min_chars": 10,

        // 整条字幕（忽略空格和标点）与以下内容完全相同时丢弃
        // Drop subtitles whose whole text (ignoring spaces and punctuation) is one of these
        "blocklist": ["感谢您的视听", "感谢观看", "谢谢观看", "感谢收看", "谢谢收看", "完"],
    },

}
